# Copy to a secrets-managed location on the server. Never commit real values.
API_IMAGE=ghcr.io/owner/fall-guardian-api:immutable-sha
SERVER_NAME=https://api.example.fr
TRUSTED_PROXIES=127.0.0.1

POSTGRES_DB=fall_guardian
POSTGRES_USER=fall_guardian
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_VERSION=16

APP_SECRET=replace-with-a-long-random-secret
DEVICE_TOKEN_HASH_SECRET=replace-with-a-different-long-random-secret

PUSH_PROVIDER=fcm
FCM_PROJECT_ID=replace-with-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","replace":"with compact JSON injected by the secret store"}
